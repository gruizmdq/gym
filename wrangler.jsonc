{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gym",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Las ramas que no son main se publican como preview (npx wrangler preview), con su
  // propia URL: sirve para probar un PR en el iPhone antes de mergearlo.
  "previews": {}
}
