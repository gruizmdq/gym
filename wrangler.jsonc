{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gym",
  "compatibility_date": "2026-11-01",
  // The OAuth provider fetches client metadata documents (CIMD): without this flag the fetch
  // could reach this same zone, which opens the door to SSRF.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // The remote MCP server (phase 7) and the push at the end of the rest (phase 8). The app's static
  // files never go through it.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/mcp",
      "/mcp/*",
      "/authorize",
      "/token",
      "/register",
      "/.well-known/*",
      "/push/*"
    ]
  },
  // OAuth grants, clients and tokens (hashed; props encrypted). Without an id, wrangler deploy
  // creates the namespace the first time.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // One alarm per device at the end of the rest. SQLite storage: the only kind on the free plan.
  "durable_objects": { "bindings": [{ "name": "REST_ALARM", "class_name": "RestAlarm" }] },
  "exports": { "RestAlarm": { "type": "durable-object", "storage": "sqlite" } },
  // The same public values as .env: the Worker reads Supabase as Gonza, with RLS.
  // For wrangler dev, .dev.vars (not committed) points them to the local Supabase.
  // VAPID_PRIVATE_KEY (the push signature, a JWK) is a secret: wrangler secret put.
  "vars": {
    "SUPABASE_URL": "https://wuampfwqeqbqbbxdqzzq.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_hOMmdvDtQlaz37NfYJ_0mA_5jnCYXcD"
  },
  // Branches other than main are published as previews (npx wrangler preview), each with
  // its own URL: useful to try a PR on the iPhone before merging it.
  "previews": {}
}
