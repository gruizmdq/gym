{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gym",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Branches other than main are published as previews (npx wrangler preview), each with
  // its own URL: useful to try a PR on the iPhone before merging it.
  "previews": {}
}
